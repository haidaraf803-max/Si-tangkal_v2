    "/monitoring/read.php": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Ambil Semua Monitoring, Riwayat Monitoring per Pohon, atau Detail Monitoring",
        "description": "Mengembalikan data monitoring beserta detail pohon terkait (termasuk koordinat lat/lng) pada setiap item, di dalam field `pohon`. Jika parameter `id` diisi, mengembalikan 1 data monitoring detail. Jika parameter `pohon_id` diisi, mengembalikan seluruh riwayat monitoring untuk pohon tersebut. Jika tidak ada parameter, mengembalikan seluruh data monitoring.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "ID monitoring untuk mengambil 1 data detail",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pohon_id",
            "in": "query",
            "required": false,
            "description": "ID pohon untuk mengambil riwayat monitoring pohon tersebut",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data Monitoring",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "total": {
                      "type": "integer",
                      "description": "Muncul saat tanpa parameter `id` (list semua / riwayat per pohon)",
                      "example": 4
                    },
                    "data": {
                      "description": "Object jika parameter `id` diisi, array jika tidak",
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/MonitoringWithPohon"
                        },
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MonitoringWithPohon"
