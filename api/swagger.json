    "/monitoring/create.php": {
      "post": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Tambah Monitoring",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "pohon_id"
                ],
                "properties": {
                  "pohon_id": {
                    "type": "integer"
                  },
                  "tanggal_monitoring": {
                    "type": "string",
                    "format": "date"
                  },
                  "kesehatan_monitoring": {
                    "type": "string"
                  },
                  "catatan": {
                    "type": "string"
                  },
                  "tinggi_pohon": {
                    "type": "number",
                    "format": "float",
                    "description": "meter"
                  },
                  "diameter_batang": {
                    "type": "number",
                    "format": "float",
                    "description": "cm (DBH)"
                  },
                  "lebar_tajuk": {
                    "type": "number",
                    "format": "float",
                    "description": "meter"
                  },
                  "jenis_gangguan": {
                    "type": "string",
                    "description": "Hama/Penyakit/Kerusakan Fisik/dll"
                  },
                  "tingkat_keparahan": {
                    "type": "string",
                    "enum": [
                      "Ringan",
                      "Sedang",
                      "Berat"
                    ]
                  },
                  "rekomendasi_tindakan": {
                    "type": "string",
                    "description": "Perlu Pemangkasan/Ditebang/dll"
                  },
                  "status_tindak_lanjut": {
                    "type": "string",
                    "enum": [
                      "Belum",
                      "Diproses",
                      "Selesai"
                    ],
                    "default": "Belum"
                  },
                  "lat": {
                    "type": "number",
                    "format": "float",
                    "description": "koordinat GPS device saat survei (opsional, dipakai utk validasi jarak & disimpan ke kolom latitude)"
                  },
                  "lng": {
                    "type": "number",
                    "format": "float",
                    "description": "koordinat GPS device saat survei (opsional, disimpan ke kolom longitude)"
                  },
                  "accuracy": {
                    "type": "number",
                    "format": "float",
                    "description": "akurasi GPS dalam meter (opsional)"
                  },
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Monitoring Berhasil Disimpan"
          }
        }
      }
    },
