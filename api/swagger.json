                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "total": {
                      "type": "integer",
                      "description": "Muncul saat tanpa parameter `id` (list/pencarian)",
                      "example": 2
                    },
                    "data": {
                      "description": "Object jika parameter `id` diisi, array jika tidak",
                      "oneOf": [
