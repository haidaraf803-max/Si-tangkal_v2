    "/trees.php": {
      "get": {
        "tags": [
          "Pohon"
        ],
        "summary": "Ambil Daftar Pohon (untuk peta/koordinat)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Pencarian bebas pada nama_lokal, family, atau kesehatan",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kesehatan[]",
            "in": "query",
            "required": false,
            "description": "Filter status kesehatan pohon (bisa lebih dari satu)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "example": "Sehat"
              }
            }
          },
          {
            "name": "status_kel[]",
            "in": "query",
            "required": false,
            "description": "Filter status konservasi (bisa lebih dari satu)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar Pohon",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pohon"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pohon/read.php": {
      "get": {
        "tags": [
          "Pohon"
        ],
        "summary": "Ambil Semua Pohon, Detail Pohon, atau Cari/Filter Pohon",
        "description": "Jika parameter `id` diisi, mengembalikan 1 data pohon detail. Jika tidak, mengembalikan daftar pohon (bisa disaring lewat `q`, `kesehatan[]`, dan `status_kel[]`).",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "ID pohon untuk mengambil 1 data detail",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Pencarian bebas pada nama_lokal, nama_latin, family, nama_jalan, atau kesehatan",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kesehatan[]",
            "in": "query",
            "required": false,
            "description": "Filter status kesehatan pohon (bisa lebih dari satu)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "example": "Sehat"
              }
            }
          },
          {
            "name": "status_kel[]",
            "in": "query",
            "required": false,
            "description": "Filter status konservasi (bisa lebih dari satu)",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
