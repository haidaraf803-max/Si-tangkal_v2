          "200": {
            "description": "Data Pohon Berhasil Diupdate"
          },
          "401": {
            "description": "Belum login"
          },
          "500": {
            "description": "Data pohon tidak ditemukan / kesalahan server"
          }
        }
      }
    },
    "/pohon/delete.php": {
      "get": {
        "tags": [
          "Pohon"
        ],
        "summary": "Hapus Data Pohon",
        "description": "Menghapus data pohon beserta file foto fisiknya (jika ada).",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data Pohon Berhasil Dihapus"
          },
          "401": {
            "description": "Belum login"
          },
          "500": {
            "description": "Data pohon tidak ditemukan / kesalahan server"
          }
        }
      }
    }
  },
